# Copy to .env and fill in. Never commit .env.

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# GitHub auth: app (recommended) | token (local dev) | anonymous (public, read-only)
PRBOT_GITHUB_AUTH=app
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=~/.secrets/prbot.private-key.pem   # keep the .pem OUTSIDE the repo
# GITHUB_APP_INSTALLATION_ID=                                    # optional; discovered from --repo
# GITHUB_TOKEN=                                                  # PAT fallback, local dev only

# Pricing override for models not in prbot/metrics.py (USD per 1M tokens)
# PRBOT_PRICE_INPUT=
# PRBOT_PRICE_CACHED=
# PRBOT_PRICE_OUTPUT=

# Agent loop
PRBOT_MAX_ATTEMPTS=3
PRBOT_MIN_SEVERITY=medium

# Docker test runner
PRBOT_TEST_IMAGE=prbot-tester:py3.12
PRBOT_TEST_TIMEOUT=120
